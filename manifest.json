{
    "manifest_version": 3,
    "name": "Gold Price Drop Notifier",
    "version": "1.3.0",
    "icons": {
        "16": "logo16x16.png",
        "32": "logo32x32.png",
        "48": "logo48x48.png",
        "128": "logo128x128.png"
    },
    "description": "India's IBJA gold rate for 24K and 22K on your toolbar, with a desktop alert when it drops below your target price.",
    "homepage_url": "https://github.com/INDERJEET0202/Gold-Price-Notifier-Chrome-Extension",
    "minimum_chrome_version": "110",
    "permissions": [
        "alarms",
        "notifications",
        "storage"
    ],
    "host_permissions": [
        "https://ibjarates.com/*",
        "https://www.ibjarates.com/*"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "action": {
        "default_popup": "popup.html",
        "default_title": "Gold Price Drop Notifier",
        "default_icon": {
            "16": "logo16x16.png",
            "32": "logo32x32.png"
        }
    }
}
